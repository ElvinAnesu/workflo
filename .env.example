# Copy to .env.local and fill in. Only server code reads these.

# SQL Server connection (SQL Server authentication)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=workflo
DB_USER=workflo_app
DB_PASSWORD=
# Encrypt the connection (default true). Trust a self-signed certificate on
# local or internal servers only.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
